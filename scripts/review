#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

case "${1:-}" in
    "")
        exec .venv/bin/python -m specialists.jane.review
        ;;
    --interactive)
        exec .venv/bin/python -m specialists.jane.review --interactive
        ;;
    --count)
        exec .venv/bin/python -m specialists.jane.review --count
        ;;
    --report)
        exec .venv/bin/python -m specialists.jane.review --report
        ;;
    --packet-preview)
        exec .venv/bin/python -m specialists.jane.review --packet-preview
        ;;
    --list|list)
        shift || true
        exec .venv/bin/python -m specialists.jane.specialist --list "$@"
        ;;
    show)
        shift
        exec .venv/bin/python -m specialists.jane.specialist --show "$@"
        ;;
    approve)
        shift
        exec .venv/bin/python -m specialists.jane.specialist --approve "$@"
        ;;
    reject)
        shift
        exec .venv/bin/python -m specialists.jane.specialist --reject "$@"
        ;;
    specialist)
        shift
        exec .venv/bin/python -m specialists.jane.specialist "$@"
        ;;
    *)
        exec .venv/bin/python -m specialists.jane.review "$@"
        ;;
esac
